---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { categoryLabel } from '../../lib/help';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const articles = await getCollection('help', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const SITE = Astro.site ?? new URL('https://chiropracticgrit.com');
const url = new URL(`/help/${article.id}`, SITE).href;

const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: article.data.title,
    description: article.data.description,
    author: { '@type': 'Organization', name: 'Chiropractic Grit' },
    publisher: {
      '@type': 'Organization',
      name: 'Chiropractic Grit',
      logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', SITE).href },
    },
    ...(article.data.updatedDate
      ? { dateModified: article.data.updatedDate.toISOString() }
      : {}),
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  },
];

if (article.data.faqs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: article.data.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={`${article.data.title} | GRIT Help`}
  description={article.data.description}
  schema={schemas}
>
  <Nav />
  <main class="page">
    <div class="container">
      <article class="post">
        <div class="post-head">
          <a class="back" href="/help">← All help articles</a>
          <div class="kicker">{categoryLabel(article.data.category)}</div>
          <h1>{article.data.title}</h1>
          {article.data.updatedDate && (
            <p class="meta">
              Updated <time datetime={article.data.updatedDate.toISOString()}>{fmt(article.data.updatedDate)}</time>
            </p>
          )}
        </div>

        {article.data.videoId && (
          <div class="video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${article.data.videoId}`}
              title={article.data.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        )}

        <div class="prose">
          <Content />
        </div>

        {article.data.faqs.length > 0 && (
          <div class="faqs">
            <h2>Common questions</h2>
            {article.data.faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        )}

        <div class="support-cta">
          <h2>Still stuck?</h2>
          <p>
            Open GRIT and hit the <strong>?</strong> button in the bottom-right corner, then
            <strong>Contact support</strong>. We respond within 1 business day.
          </p>
        </div>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page { padding: 52px 0 84px; }
  .post { max-width: 720px; margin: 0 auto; }

  .post-head { display: grid; gap: 14px; margin-bottom: 36px; }
  .back {
    color: var(--subtle);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .back:hover { color: var(--text); }

  .kicker {
    color: var(--ember);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    margin: 0;
  }

  .meta { color: var(--subtle); font-size: 0.92rem; margin: 0; }

  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-bottom: 32px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: #000;
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Prose typography lives in src/styles/prose.css (shared with the blog). */

  .faqs { margin-top: 48px; display: grid; gap: 10px; }
  .faqs h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .faqs details {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 18px;
    background: linear-gradient(180deg, rgba(255,255,255,0.026), rgba(255,255,255,0.014));
  }
  .faqs summary {
    color: var(--text);
    font-weight: 700;
    cursor: pointer;
    font-size: 0.98rem;
  }
  .faqs details p { color: var(--muted); line-height: 1.65; margin: 12px 0 2px; }

  .support-cta {
    margin-top: 56px;
    padding: 32px 36px;
    border: 1px solid var(--line-strong);
    border-radius: 20px;
    background: linear-gradient(160deg, rgba(86, 38, 12, 0.55), rgba(60, 28, 8, 0.7));
    display: grid;
    gap: 8px;
  }
  .support-cta h2 { margin: 0; font-size: 1.35rem; letter-spacing: -0.03em; }
  .support-cta p { margin: 0; color: var(--muted); line-height: 1.65; }
  .support-cta strong { color: var(--text); }
</style>
