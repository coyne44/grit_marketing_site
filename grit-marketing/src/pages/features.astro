---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const sections = [
  { id: 'scheduling', label: 'Scheduling' },
  { id: 'patients', label: 'Patients' },
  { id: 'portal', label: 'Portal' },
  { id: 'notes', label: 'Clinical Notes' },
  { id: 'treatment-plans', label: 'Treatment Plans' },
  { id: 'cases', label: 'Cases' },
  { id: 'billing', label: 'Billing' },
  { id: 'texting', label: 'Texting' },
  { id: 'payments', label: 'Payments' },
  { id: 'team', label: 'Team' },
  { id: 'security', label: 'Security' },
];

const comparison = [
  { label: 'Built for', grit: 'Solo chiropractors', them: 'Hospitals, then scaled down' },
  { label: 'Interface', grit: 'Clean, modern, fast', them: 'Tabs inside tabs inside tabs' },
  { label: 'Note speed', grit: 'Macros + spine diagram + auto-save', them: 'Click-heavy templates from 2009' },
  { label: 'Patient portal', grit: 'Built in. Booking, check-in, forms, messaging', them: '$50/month add-on (if it exists)' },
  { label: 'Texting', grit: 'Built in via Telnyx', them: 'Third-party integration, extra cost' },
  { label: 'Payments', grit: 'Built in via Stripe', them: 'Another vendor, another login' },
  { label: 'HIPAA compliance', grit: 'Audit logs, amendment tracking, role-based access', them: '"We\'re HIPAA compliant" (citation needed)' },
  { label: 'Pricing', grit: 'One price. Everything included', them: 'Base + portal + texting + payments + support' },
  { label: 'Setup', grit: 'Minutes', them: 'Days to weeks, plus training fees' },
  { label: 'Feels like', grit: '2025', them: 'Somehow, still 2008' },
];
---

<BaseLayout
  title="Features | Chiropractic Grit"
  description="Scheduling, SOAP notes, patient portal, automated texting, payments, and more. Every feature built specifically for solo chiropractors."
>
  <Nav />

  <main class="page">

    <!-- Page header -->
    <div class="container">
      <div class="page-header">
        <div class="kicker">Features</div>
        <h1>Built from scratch.<br />For the way you work.</h1>
        <p class="header-copy">
          Not downsized from a hospital system. Not repurposed from general practice.
          Every screen, every workflow, every button exists because a solo chiropractor needs it.
        </p>
      </div>
    </div>

    <!-- Sticky anchor nav -->
    <div class="anchor-nav-wrap">
      <div class="container">
        <nav class="anchor-nav" aria-label="Feature sections">
          {sections.map((s) => (
            <a href={`#${s.id}`} class="anchor-link">{s.label}</a>
          ))}
        </nav>
      </div>
    </div>

    <div class="container sections-wrap">

      <!-- Scheduling -->
      <section class="feature-section" id="scheduling">
        <div class="section-head">
          <div class="section-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
          </div>
          <div class="kicker">Scheduling & Calendar</div>
          <h2>Your day, your way — visualized down to the minute.</h2>
          <p class="section-copy">Built around high-volume chiropractic practices where a 10-minute adjustment window is the norm, not the exception.</p>
        </div>
        <div class="feature-grid">
          <div class="feature-item"><strong>Weekly calendar view</strong> — color-coded blocks sized by duration. Spot openings and bottlenecks at a glance.</div>
          <div class="feature-item"><strong>Configurable time slots</strong> — 5, 10, 15, or 30-minute grids. Set it to match how you practice.</div>
          <div class="feature-item"><strong>Custom appointment types</strong> — New Patient, Adjustment, Re-Eval, and whatever else you need. Each gets its own color and duration.</div>
          <div class="feature-item"><strong>Recurring appointments</strong> — book a patient every Tuesday and Thursday for 6 weeks in one action. Daily, weekly, and monthly recurrence with flexible end conditions.</div>
          <div class="feature-item"><strong>Appointment status tracking</strong> — Scheduled → Checked In → In Progress → Completed. Mark no-shows. Cancel with a reason. Every transition is tracked.</div>
          <div class="feature-item"><strong>Time-off management</strong> — vacation, sick days, holidays. All-day or partial. Visual striping on the calendar so nothing gets booked over it.</div>
          <div class="feature-item"><strong>Bulk operations</strong> — cancel multiple appointments or mark a block of no-shows in one action. Because sometimes a snowstorm happens.</div>
          <div class="feature-item"><strong>Per-day working hours</strong> — custom start/end times for every day of the week. Monday doesn't always look like Thursday.</div>
        </div>
      </section>

      <!-- Patient Management -->
      <section class="feature-section" id="patients">
        <div class="section-head">
          <div class="section-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
          </div>
          <div class="kicker">Patient Management</div>
          <h2>Every patient. Every detail. One place.</h2>
          <p class="section-copy">The full picture of each patient — not just name and phone number, but everything you need to treat, bill, and communicate with them.</p>
        </div>
        <div class="feature-grid">
          <div class="feature-item"><strong>Complete patient profiles</strong> — demographics, two phone numbers, full address, employer, marital status, spouse info, and emergency contact. Every field from your paper intake form, digitized.</div>
          <div class="feature-item"><strong>Instant search</strong> — find any patient by name, email, or phone. Case-insensitive, real-time results as you type.</div>
          <div class="feature-item"><strong>Inline editing</strong> — click any field, edit it, save. No separate modals, no navigating away.</div>
          <div class="feature-item"><strong>Patient images</strong> — store up to 10 clinical images per patient. X-rays, posture photos, progress shots — right on the profile.</div>
          <div class="feature-item"><strong>Insurance management</strong> — primary and secondary coverage with member info, copay, deductible, coinsurance, visit limits, and authorization tracking. Upload front and back card images.</div>
          <div class="feature-item"><strong>Staff verification workflow</strong> — mark insurance as verified with notes, verified-by, and timestamp. Deactivate and reactivate policies without deleting history.</div>
        </div>
      </section>

      <!-- Patient Portal -->
      <section class="feature-section" id="portal">
        <div class="section-head">
          <div class="section-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg>
          </div>
          <div class="kicker">Patient Portal</div>
          <h2>Give your patients a front door to your practice — open 24/7.</h2>
          <p class="section-copy">A real self-service experience that reduces phone calls and front desk burden from day one. Not a bolt-on. Not an add-on. Built in.</p>
        </div>

        <div class="portal-cards">
          <div class="portal-card">
            <div class="portal-card-title">Online Booking</div>
            <ul>
              <li>Patients book from available slots that respect your real schedule, lunch, and time off</li>
              <li>Only providers they've seen before — no accidental bookings with the wrong doc</li>
              <li>You control which appointment types are self-bookable</li>
              <li>You get notified. They get a confirmation</li>
            </ul>
          </div>
          <div class="portal-card">
            <div class="portal-card-title">Booking Controls</div>
            <ul>
              <li>Enable or disable self-booking with one toggle</li>
              <li>Minimum advance booking windows (1 hour to 1 week)</li>
              <li>Cancellation windows to prevent last-minute no-shows</li>
              <li>Overbooking controls with configurable max-per-slot limits</li>
              <li>Per-provider, per-appointment-type configuration</li>
            </ul>
          </div>
          <div class="portal-card">
            <div class="portal-card-title">Self-Service Check-In</div>
            <ul>
              <li>Verify contact info and insurance before they sit down</li>
              <li>Rate each active complaint (0–10) and report changes</li>
              <li>Report new concerns so you know before you walk in the room</li>
            </ul>
          </div>
          <div class="portal-card">
            <div class="portal-card-title">Intake Forms & HIPAA</div>
            <ul>
              <li>Full digital health history — complaints, medications, allergies, surgeries, family history, lifestyle</li>
              <li>Auto-generates a PDF on completion</li>
              <li>HIPAA consent with digital signature, date stamp, and IP logging</li>
              <li>Signed PDFs stored automatically for your records</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Clinical Notes -->
      <section class="feature-section" id="notes">
        <div class="section-head">
          <div class="section-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
          </div>
          <div class="kicker">Clinical Notes</div>
          <h2>Chart faster than you ever have. Stay compliant while you do it.</h2>
          <p class="section-copy">Purpose-built for chiropractic documentation — SOAP notes, initial evaluations, re-evaluations, and discharge summaries with the depth your payers require and the speed your schedule demands.</p>
        </div>

        <div class="notes-layout">
          <div class="notes-speed">
            <div class="notes-col-title">Write notes fast</div>
            <div class="feature-item"><strong>Macros</strong> — personal text shortcuts organized by SOAP section. Name them, write once, insert at cursor with a single click. Build a library of your most common findings.</div>
            <div class="feature-item"><strong>Interactive spine diagram</strong> — clickable vertebrae from Occiput to Coccyx. Click a level and it inserts into your Objective field at the cursor. No typing "T4-T6 subluxation complex."</div>
            <div class="feature-item"><strong>Previous note pull-forward</strong> — GRIT fetches your last signed note. Check a box and carry forward what hasn't changed.</div>
            <div class="feature-item"><strong>Auto-save every 3 seconds</strong> — no more lost work because you forgot to hit save.</div>
          </div>

          <div class="notes-compliance">
            <div class="notes-col-title">Stay compliant</div>
            <div class="feature-item"><strong>Note lifecycle</strong> — Draft → Signed → Billed → Locked. Once signed, the note is read-only. Period.</div>
            <div class="feature-item"><strong>Digital signature with attestation</strong> — captures provider, timestamp, and auto-generates a formal attestation statement.</div>
            <div class="feature-item"><strong>HIPAA-compliant amendments</strong> — every change records who made it, when, original value, new value, and why. The original is never overwritten.</div>
            <div class="feature-item"><strong>Clinical audit log</strong> — every view, create, update, delete, print, and export is logged with user, IP address, timestamp, and before/after values.</div>
          </div>
        </div>

        <div class="notes-detail-grid">
          <div class="detail-card">
            <div class="detail-title">Note Types</div>
            <ul><li>SOAP Notes</li><li>Initial Evaluations</li><li>Re-Evaluations</li><li>Discharge Summaries</li></ul>
          </div>
          <div class="detail-card">
            <div class="detail-title">Exam Findings</div>
            <ul><li>Subluxation analysis</li><li>Range of motion</li><li>Orthopedic tests</li><li>Neurological exam</li><li>Postural analysis</li><li>Palpation findings</li></ul>
          </div>
          <div class="detail-card">
            <div class="detail-title">Billing-Ready</div>
            <ul><li>ICD-10 codes with CMS-1500 Box 21 pointers</li><li>CPT codes with units, modifiers, charges</li><li>Diagnosis pointers per procedure</li><li>CMT region tracking</li></ul>
          </div>
          <div class="detail-card">
            <div class="detail-title">Vitals & Systems</div>
            <ul><li>BP, pulse, temp, height, weight</li><li>Auto-calculated BMI</li><li>Structured 9+ system review</li><li>Complaint pain trends over time</li></ul>
          </div>
        </div>
      </section>

      <!-- Treatment Plans -->
      <section class="feature-section" id="treatment-plans">
        <div class="section-head">
          <div class="section-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" /></svg>
          </div>
          <div class="kicker">Treatment Plans</div>
          <h2>Map out the care. Track the progress. Know exactly where every patient stands.</h2>
          <p class="section-copy">Every note shows a color-coded progress banner so you always know where a patient is in their care plan — without digging through the chart.</p>
        </div>
        <div class="feature-grid">
          <div class="feature-item"><strong>Plan items</strong> — define each phase of care with appointment type, frequency (3x/week for 4 weeks), or flat quantity, and sequence order.</div>
          <div class="feature-item"><strong>Plan templates</strong> — build reusable templates at the practice level. Your most common care plans are one click away.</div>
          <div class="feature-item"><strong>Link plans to appointments</strong> — assign a plan to any appointment so each visit counts toward the total automatically.</div>
          <div class="feature-item"><strong>Treatment goals</strong> — set measurable goals (pain reduction, ROM improvement, return to work) with baseline, target, and current values. Track achievement dates.</div>
        </div>
        <div class="plan-progress">
          <div class="progress-label">Plan progress banner on every note:</div>
          <div class="progress-badges">
            <div class="badge badge-blue">4+ visits remaining</div>
            <div class="badge badge-amber">2–3 visits left</div>
            <div class="badge badge-red">Last visit</div>
            <div class="badge badge-green">Plan complete</div>
          </div>
        </div>
      </section>

      <!-- Cases -->
      <section class="feature-section" id="cases">
        <div class="section-head">
          <div class="section-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" /></svg>
          </div>
          <div class="kicker">Cases & Problem List</div>
          <h2>Organize complex patients without complexity.</h2>
          <p class="section-copy">Group visits, complaints, diagnoses, and goals under a specific case — with full support for the case types that actually matter in chiropractic.</p>
        </div>
        <div class="feature-grid">
          <div class="feature-item"><strong>Standard care</strong> — straightforward episodic care cases.</div>
          <div class="feature-item"><strong>Personal injury (PI)</strong> — with attorney name, firm, phone, email, and claim number.</div>
          <div class="feature-item"><strong>Workers' compensation</strong> — employer details, job title, and injury description.</div>
          <div class="feature-item"><strong>Auto accident & Medicare</strong> — dedicated case types with appropriate fields.</div>
          <div class="feature-item"><strong>Problem list</strong> — running list of diagnoses with ICD-10 codes, status (active, chronic, resolved, ruled out), laterality, and primary diagnosis flag.</div>
          <div class="feature-item"><strong>Pain trend tracking</strong> — every check-in captures complaint ratings automatically. Pain trends build over time with no extra charting work.</div>
        </div>
      </section>

      <!-- Billing -->
      <section class="feature-section" id="billing">
        <div class="section-head">
          <div class="section-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25M9 12.75h6m-6 2.25h3m-3-9h6.75m-3.75 11.25v-2.25m0 0V3.375m0 11.25H5.625c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H9" /></svg>
          </div>
          <div class="kicker">Billing & Superbills</div>
          <h2>Get the paperwork right so you get paid right.</h2>
          <p class="section-copy">Billing data is entered at the point of care — not reconstructed after the fact. Your superbills are accurate because your notes are accurate.</p>
        </div>
        <div class="feature-grid">
          <div class="feature-item"><strong>Superbill generation</strong> — select any completed appointment with a signed note and generate a clean, professional PDF.</div>
          <div class="feature-item"><strong>Batch superbills</strong> — select multiple visits and generate a combined PDF in one action.</div>
          <div class="feature-item"><strong>Patient-facing superbills</strong> — patients download their own PDFs from the portal for insurance reimbursement. Zero staff work required.</div>
          <div class="feature-item"><strong>Encounter-level billing data</strong> — ICD-10 diagnosis pointers, CPT codes with units, up to 4 modifiers, charge amounts, and regions treated for CMT codes. Everything your biller needs, built into every note.</div>
        </div>
      </section>

      <!-- Texting -->
      <section class="feature-section" id="texting">
        <div class="section-head">
          <div class="section-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
          </div>
          <div class="kicker">Automated Patient Texting</div>
          <h2>Stop playing phone tag. Let GRIT handle the communication.</h2>
          <p class="section-copy">Automated reminders, two-way texting, and customizable templates — built directly into GRIT via Telnyx. One login, one system, one workflow.</p>
        </div>
        <div class="feature-grid">
          <div class="feature-item"><strong>Automated appointment reminders</strong> — set your timing rules once. GRIT sends SMS reminders before every appointment automatically.</div>
          <div class="feature-item"><strong>Two-way texting</strong> — patients can confirm, cancel, or reply. Their responses come straight into GRIT, not your personal phone.</div>
          <div class="feature-item"><strong>Customizable message templates</strong> — write messages that sound like your practice, not a corporate script.</div>
          <div class="feature-item"><strong>Delivery tracking</strong> — know whether a message was delivered, not just sent.</div>
        </div>
      </section>

      <!-- Payments -->
      <section class="feature-section" id="payments">
        <div class="section-head">
          <div class="section-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" /></svg>
          </div>
          <div class="kicker">Payments</div>
          <h2>Collect what you're owed — before, during, or after the visit.</h2>
          <p class="section-copy">Stripe-powered. PCI-DSS compliant out of the box. Card data never touches your server. Zero setup on your end.</p>
        </div>
        <div class="feature-grid">
          <div class="feature-item"><strong>In-app payment collection</strong> — collect copays, balances, and visit fees right from the patient's profile.</div>
          <div class="feature-item"><strong>Text-to-pay</strong> — send a secure payment link via SMS. Patients pay from their phone before they even walk through the door.</div>
          <div class="feature-item"><strong>Automatic receipts</strong> — every payment generates a receipt. No more handwritten slips.</div>
          <div class="feature-item"><strong>Per-patient payment history</strong> — see every payment a patient has made, when, and for what.</div>
        </div>
      </section>

      <!-- Team -->
      <section class="feature-section" id="team">
        <div class="section-head">
          <div class="section-icon">
