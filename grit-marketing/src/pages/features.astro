---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import WaitlistCTA from '../components/ui/WaitlistCTA.astro';
import { PRICING } from '../lib/site';

// Grouped by the moment in the workday they serve, not by module.
const groups = [
  {
    kicker: 'Before the visit',
    title: 'The schedule runs itself.',
    copy: 'The front desk work that eats mornings — booking, reminders, intake — happens without anyone standing at the desk.',
    items: [
      {
        name: 'Scheduling',
        points: [
          'Your week at a glance, with custom appointment types and recurring bookings.',
          'Online self-booking from real availability — it respects your schedule, your lunch, and your time off.',
          'New-patient requests come in verified and reviewed, never auto-dumped onto your calendar.',
        ],
      },
      {
        name: 'Text & email reminders',
        points: [
          'Automatic reminders that go out in your practice’s time zone, consent-aware from the first message.',
          'Two-way texting with delivery tracking — patients confirm or ask questions by reply.',
        ],
      },
      {
        name: 'Digital intake',
        points: [
          'Full health history and signed HIPAA consent, completed from the patient’s couch.',
          'Self check-in: patients rate complaints and report changes before you walk in the room.',
        ],
      },
    ],
  },
  {
    kicker: 'In the room',
    title: 'Chart in under a minute.',
    copy: 'The clinical tools were built by watching where chiropractic notes actually lose time — then removing exactly that.',
    items: [
      {
        name: 'Clinical notes',
        points: [
          'SOAP, initial eval, and re-eval — with a macro library of your own shortcuts per section.',
          'A clickable spine diagram: tap the level, and it writes itself into your objective field.',
          'Pull-forward carries unchanged findings from your last signed note in one click.',
          'Signed notes are read-only; amendments are tracked with who, when, and why.',
        ],
      },
      {
        name: 'Care plans',
        points: [
          'Build the plan once from a template, schedule the visits, track the progress.',
          'Progress banners and measurable goals keep the plan visible at every visit.',
        ],
      },
      {
        name: 'Cases & records',
        points: [
          'PI, workers’ comp, auto, Medicare — cases with ICD-10 problem lists and pain-trend tracking.',
          'Complete patient profiles: history, insurance cards, clinical images.',
        ],
      },
    ],
  },
  {
    kicker: 'Getting paid',
    title: 'The money side, closed.',
    copy: 'Charging patients, generating superbills, and billing insurance — the part of practice ownership nobody wanted — handled in the same place the note was written.',
    items: [
      {
        name: 'Patient payments',
        points: [
          'Card at the desk or in the portal, powered by Stripe — saved cards, text-to-pay, automatic receipts.',
          'Visit charges post from the signed note, so the balance is right before the patient reaches the desk.',
        ],
      },
      {
        name: 'Billing & superbills',
        points: [
          'ICD-10 and CPT at the point of care, one-click superbill PDFs.',
          'Patients download their own superbills from the portal — zero staff work.',
        ],
      },
      {
        name: 'Secure messaging',
        points: [
          'Patient conversations that don’t live on your personal phone — in-app, role-aware, HIPAA-conscious.',
        ],
      },
    ],
  },
  {
    kicker: 'The practice itself',
    title: 'Built to be run by two people. Or one.',
    copy: 'Everything an office manager would babysit in another system is either automatic or one screen deep.',
    items: [
      {
        name: 'Team & roles',
        points: [
          'Unlimited staff accounts, included — front desk, office manager, biller. Staff are never a seat you pay for.',
          'Role-based access: providers, staff, and patients each see exactly what they should.',
        ],
      },
      {
        name: 'Bring your data',
        points: [
          'Import patients, insurance, and appointments from your old EHR’s CSV or Excel exports.',
          'Dry-run preview before anything is written, and your data exports back out anytime.',
        ],
      },
      {
        name: 'HIPAA, seriously',
        points: [
          'A full clinical audit log records every access to patient data — append-only, down to the database.',
          'Amendment-only signed notes, encrypted data in transit and at rest, and a BAA with every account.',
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="Features — Chiropractic EHR for Independent Practices | Chiropractic Grit"
  description={`Scheduling, chiropractic SOAP notes, care plans, patient portal, text reminders, patient payments, and optional insurance billing — every feature built for the independent chiropractor. $${PRICING.base}/mo.`}
>
  <Nav />

  <main class="page">
    <div class="container">

      <header class="page-header">
        <div class="rule"><span class="kicker">Features</span></div>
        <h1>Built from scratch.<br />For the way you work.</h1>
        <p class="header-copy">
          Not downsized from a hospital system. Not repurposed from general practice.
          Every screen exists because an independent chiropractor's day needs it.
        </p>
      </header>

      {groups.map((group) => (
        <section class="group">
          <SectionHeader kicker={group.kicker} title={group.title} copy={group.copy} />
          <div class="items">
            {group.items.map((item) => (
              <article>
                <h3>{item.name}</h3>
                <ul>
                  {item.points.map((p) => <li>{p}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </section>
      ))}

      <!-- Insurance add-on spotlight -->
      <section class="insurance paper">
        <div class="ins-head">
          <span class="kicker ins-kicker">The insurance add-on · +${PRICING.insuranceAddon}/mo, optional</span>
          <h2>We catch it before it costs you.</h2>
          <p>
            Most chiropractic denials aren't missing fields — they're code ordering and
            modifiers. Grit checks every claim against payer-aware rules <em>before</em> it
            leaves, on data it already holds from your signed note.
          </p>
        </div>
        <div class="ins-grid">
          <div>
            <h3>Claims from the note</h3>
            <p>A signed note becomes a claim — diagnoses, procedures, and pointers already in place. No re-keying.</p>
          </div>
          <div>
            <h3>Checked before it leaves</h3>
            <p>Modifier and ordering rules, documented-region checks against the CMT code, timely-filing warnings before a deadline quietly passes.</p>
          </div>
          <div>
            <h3>Tracked until it pays</h3>
            <p>Status straight from the clearinghouse, stale claims surfaced instead of sitting silently, remittances posted when the payment lands.</p>
          </div>
          <div>
            <h3>The patient owes the right amount</h3>
            <p>Only true patient responsibility reaches a balance — contractual write-offs never get billed to a patient by mistake.</p>
          </div>
        </div>
        <p class="ins-fine">
          You bring your own Claim.MD clearinghouse account — their subscription and support
          relationship stay with them; the workflow lives in Grit.
        </p>
      </section>

    </div>
  </main>

  <WaitlistCTA
    kicker="Early access"
    title="See it run your kind of day."
    copy="Join the waitlist and we'll reach out before launch — no credit card, no sales call."
  />

  <Footer />
</BaseLayout>

<style>
  .page {
    padding: 52px 0 20px;
  }

  .rule {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 560px;
  }

  .rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  .page-header {
    max-width: 720px;
    margin-bottom: 24px;
    display: grid;
    gap: 16px;
  }

  h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    line-height: 1.04;
  }

  .header-copy {
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
    margin: 0;
  }

  .group {
    padding-top: 76px;
    display: grid;
    gap: 38px;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .items article {
    border-top: 1px solid var(--line-strong);
    padding-top: 18px;
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .items h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  .items ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .items li {
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.6;
    padding-left: 16px;
    position: relative;
  }

  .items li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--ember-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  /* Insurance spotlight */
  .insurance {
    margin-top: 90px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-paper);
    padding: clamp(32px, 5vw, 56px);
    display: grid;
    gap: 36px;
  }

  .ins-head {
    display: grid;
    gap: 14px;
    max-width: 680px;
  }

  .ins-kicker {
    color: var(--ember);
  }

  .insurance h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    color: var(--ink);
  }

  .ins-head p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .ins-head em {
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
  }

  .ins-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 26px 40px;
  }

  .ins-grid > div {
    border-top: 1px solid var(--line-paper);
    padding-top: 14px;
    display: grid;
    gap: 6px;
  }

  .ins-grid h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .ins-grid p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .ins-fine {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.88rem;
    border-top: 1px solid var(--line-paper);
    padding-top: 18px;
  }

  @media (max-width: 900px) {
    .items {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ins-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
