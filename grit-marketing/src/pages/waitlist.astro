---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PRICING } from '../lib/site';

// INVARIANTS (cited by /sms as the TCR opt-in evidence; wired to Formspree):
// form action + method, every field name, the sms_consent checkbox and its
// consent language, the phone-format + consent-validation script, and the
// AJAX success state. Redesign freely; change none of those without
// reconciling /sms in the same PR.

const ehrs = [
  'ChiroTouch',
  'Jane App',
  'Genesis Chiropractic Software',
  'ECLIPSE',
  'ChiroFusion',
  'DrChrono',
  'AdvancedMD',
  'Kareo / Tebra',
  'Practice Fusion',
  'PayDC',
  'ChiroSpring',
  'Platinum System',
  'EHR Your Way',
  'Other',
  'None — I don\'t currently use an EHR',
];
---

<BaseLayout
  title="Join the Waitlist | Chiropractic Grit"
  description={`Early access to Grit, the chiropractic EHR for independent chiropractors. $${PRICING.base}/month, one provider, unlimited staff accounts. No credit card required to join.`}
>
  <Nav />

  <main class="page">
    <div class="container">
      <div class="layout">

        <!-- Left: pitch -->
        <div class="pitch">
          <div class="rule"><span class="kicker">Early access</span></div>
          <h1>Be first in line.</h1>
          <p class="pitch-copy">
            Grit is a modern EHR built for the independent chiropractor. Scheduling,
            SOAP notes, care plans, patient payments, text reminders, secure messaging —
            and insurance billing when you want it. ${PRICING.base} a month. No sales call.
          </p>

          <ul class="perks">
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="18" height="18" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Direct line to the team — your feedback shapes the product
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="18" height="18" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              Free onboarding support when you launch
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="18" height="18" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              We help move your patients over from your old EHR
            </li>
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="18" height="18" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
              No credit card required to join
            </li>
          </ul>

          <div class="brand-badge">
            <div class="brand-mark">G</div>
            <div class="brand-text">
              <small>CHIROPRACTIC</small>
              <span>GRIT</span>
            </div>
          </div>
        </div>

        <!-- Right: the form, on paper -->
        <div class="form-card paper" id="form-card">
          <div class="form-head">
            <h2>Join the waitlist</h2>
            <p>Takes less than a minute. We'll reach out before launch.</p>
          </div>

          <form
            action="https://formspree.io/f/mykbzwjp"
            method="POST"
            id="waitlist-form"
            class="form"
          >
            <div class="row-2">
              <div class="field">
                <label for="first_name">First Name</label>
                <input type="text" id="first_name" name="first_name" placeholder="Jane" required />
              </div>
              <div class="field">
                <label for="last_name">Last Name</label>
                <input type="text" id="last_name" name="last_name" placeholder="Smith" required />
              </div>
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="jane@yourpractice.com" required />
            </div>

            <div class="field">
              <label for="phone">Phone Number <span class="optional">(optional)</span></label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="(555) 123-4567"
                autocomplete="tel"
                inputmode="numeric"
                maxlength="14"
              />
            </div>

            <div class="field consent-field">
              <label class="consent-label">
                <input type="checkbox" id="sms_consent" name="sms_consent" value="yes" />
                <span class="consent-box-text">
                  <strong>Text me</strong>
                  By signing up via text, you agree to receive recurring waitlist, onboarding,
                  billing, and platform messages from Chiropractic Grit at the phone number
                  provided. Consent is not a condition of purchase. Reply STOP to unsubscribe.
                  Reply HELP for help. Message frequency varies. Msg &amp; data rates may apply.
                  View our <a href="/privacy">Privacy Policy</a> and
                  <a href="/terms">Terms of Service</a>.
                </span>
              </label>
            </div>

            <div class="field">
              <label for="practice_name">Practice Name</label>
              <input type="text" id="practice_name" name="practice_name" placeholder="Smith Chiropractic" />
            </div>

            <div class="field">
              <label for="situation">Current Situation</label>
              <div class="select-wrap">
                <select id="situation" name="situation" required>
                  <option value="" disabled selected>Select one…</option>
                  <option value="just_starting">Just starting up</option>
                  <option value="currently_practicing">Currently practicing</option>
                  <option value="exploring">Exploring options</option>
                </select>
                <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
              </div>
            </div>

            <div class="field">
              <label for="current_ehr">Current EHR</label>
              <div class="select-wrap">
                <select id="current_ehr" name="current_ehr">
                  <option value="" disabled selected>Select one…</option>
                  {ehrs.map((ehr) => (
                    <option value={ehr}>{ehr}</option>
                  ))}
                </select>
                <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
              </div>
            </div>

            <div class="field">
              <label>Would you want to transfer data from your current EHR?</label>
              <div class="radio-group">
                <label class="radio-label">
                  <input type="radio" name="transfer_data" value="yes" />
                  <span>Yes</span>
                </label>
                <label class="radio-label">
                  <input type="radio" name="transfer_data" value="no" />
                  <span>No</span>
                </label>
              </div>
            </div>

            <div class="field">
              <label for="anything_else">What would make Grit perfect for your practice?</label>
              <textarea id="anything_else" name="anything_else" rows="3" placeholder="Feel free to share anything — features you need, frustrations with your current setup, questions…"></textarea>
            </div>

            <button type="submit" class="submit-btn">Request Early Access</button>

            <p class="fine-print">No credit card required. We'll never spam you.</p>
          </form>

          <div class="success-state" id="success-state" style="display:none">
            <div class="success-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="28" height="28" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            </div>
            <h3>You're on the list.</h3>
            <p>We'll be in touch before launch. Keep building something great.</p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const successState = document.getElementById('success-state');
  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
  const consentInput = document.getElementById('sms_consent') as HTMLInputElement | null;

  phoneInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    const digits = target.value.replace(/\D/g, '').slice(0, 10);
    let formatted = '';
    if (digits.length > 0) formatted = '(' + digits.slice(0, 3);
    if (digits.length >= 3) formatted += ') ' + digits.slice(3, 6);
    if (digits.length >= 6) formatted += '-' + digits.slice(6, 10);
    target.value = formatted;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (consentInput?.checked && (phoneInput?.value.replace(/\D/g, '').length ?? 0) < 10) {
      alert('Please enter a valid 10-digit phone number to receive SMS updates, or uncheck the SMS box.');
      phoneInput?.focus();
      return;
    }

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const res = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
    });

    if (res.ok) {
      form.style.display = 'none';
      if (successState) successState.style.display = 'flex';
    } else {
      btn.disabled = false;
      btn.textContent = 'Request Early Access';
      alert('Something went wrong. Please try again.');
    }
  });
</script>

<style>
  .page {
    padding: 52px 0 84px;
    min-height: calc(100vh - 74px);
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: start;
  }

  /* Pitch (charcoal side) */
  .pitch {
    position: sticky;
    top: 108px;
  }

  .rule {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    max-width: 420px;
  }

  .rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  h1 {
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    line-height: 1.02;
    margin-bottom: 18px;
  }

  .pitch-copy {
    color: var(--muted);
    line-height: 1.7;
    font-size: 1.05rem;
    margin: 0 0 32px;
    max-width: 46ch;
  }

  .perks {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    display: grid;
    gap: 12px;
  }

  .perks li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.5;
  }

  .perks li svg {
    color: var(--ember-strong);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .brand-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }

  .brand-mark {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--ember);
    display: grid;
    place-items: center;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-mono);
  }

  .brand-text small {
    font-size: 0.56rem;
    letter-spacing: 0.3em;
    color: var(--subtle);
    margin-bottom: 4px;
    font-weight: 600;
  }

  .brand-text span {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text);
  }

  /* Form card — the paper panel */
  .form-card {
    border-radius: var(--radius-lg);
    padding: 36px;
    box-shadow: var(--shadow-paper);
  }

  .form-head {
    margin-bottom: 26px;
  }

  h2 {
    font-size: 1.55rem;
    margin: 0 0 6px;
    color: var(--ink);
  }

  .form-head p {
    color: var(--ink-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  /* Fields */
  .form {
    display: grid;
    gap: 18px;
  }

  .row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .field {
    display: grid;
    gap: 7px;
  }

  .field > label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  textarea {
    background: #fff;
    border: 1px solid var(--line-paper-strong);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    color: var(--ink);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
    width: 100%;
    box-sizing: border-box;
  }

  input::placeholder,
  textarea::placeholder {
    color: rgba(42, 42, 42, 0.34);
  }

  input:focus,
  textarea:focus {
    border-color: var(--ember);
    box-shadow: 0 0 0 3px rgba(199, 78, 14, 0.14);
  }

  .optional {
    color: var(--ink-muted);
    font-weight: 400;
  }

  /* SMS consent block */
  .consent-field {
    border-top: 1px solid var(--line-paper);
    padding-top: 18px;
    margin-top: 4px;
  }

  .consent-label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    cursor: pointer;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .consent-label input[type='checkbox'] {
    margin-top: 3px;
    width: 16px;
    height: 16px;
    accent-color: var(--ember);
    cursor: pointer;
    flex-shrink: 0;
  }

  .consent-box-text strong {
    color: var(--ink);
    font-weight: 700;
    display: block;
    margin-bottom: 4px;
  }

  .consent-box-text a {
    color: var(--ember);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  textarea {
    resize: vertical;
    min-height: 88px;
    line-height: 1.55;
  }

  /* Select */
  .select-wrap {
    position: relative;
  }

  .select-wrap select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    background: #fff;
    border: 1px solid var(--line-paper-strong);
    border-radius: var(--radius-sm);
    padding: 12px 38px 12px 14px;
    color: var(--ink);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 150ms ease;
    cursor: pointer;
    box-sizing: border-box;
  }

  .select-wrap select:focus {
    border-color: var(--ember);
  }

  .select-wrap select option {
    background: #fff;
    color: var(--ink);
  }

  .select-icon {
    position: absolute;
    right: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-muted);
    pointer-events: none;
  }

  /* Radio */
  .radio-group {
    display: flex;
    gap: 12px;
  }

  .radio-label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--ink-muted);
    padding: 10px 16px;
    border: 1px solid var(--line-paper-strong);
    border-radius: var(--radius-sm);
    transition: border-color 150ms ease, background 150ms ease;
    flex: 1;
    justify-content: center;
    background: #fff;
  }

  .radio-label:has(input:checked) {
    border-color: var(--ember);
    background: rgba(199, 78, 14, 0.08);
    color: var(--ink);
  }

  .radio-label input {
    accent-color: var(--ember);
  }

  /* Submit */
  .submit-btn {
    width: 100%;
    min-height: 52px;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--ember);
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: 180ms ease;
    box-shadow: 0 12px 28px rgba(199, 78, 14, 0.24);
    margin-top: 4px;
  }

  .submit-btn:hover {
    background: var(--ember-strong);
    transform: translateY(-1px);
    box-shadow: 0 16px 32px rgba(199, 78, 14, 0.3);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .fine-print {
    text-align: center;
    color: var(--ink-muted);
    font-size: 0.82rem;
    margin: 0;
  }

  /* Success */
  .success-state {
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px 20px;
    gap: 16px;
  }

  .success-icon {
    width: 60px;
    height: 60px;
    border-radius: 999px;
    background: rgba(199, 78, 14, 0.12);
    color: var(--ember);
    display: grid;
    place-items: center;
  }

  .success-state h3 {
    font-size: 1.6rem;
    margin: 0;
    color: var(--ink);
  }

  .success-state p {
    color: var(--ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .pitch {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .form-card {
      padding: 24px;
    }

    .row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
