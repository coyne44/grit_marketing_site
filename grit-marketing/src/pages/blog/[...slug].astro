---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const SITE = Astro.site ?? new URL('https://chiropracticgrit.com');
const url = new URL(`/blog/${post.id}`, SITE).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  author: { '@type': 'Person', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: 'Chiropractic Grit',
    logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', SITE).href },
  },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={`${post.data.title} | Chiropractic Grit`}
  description={post.data.description}
  schema={articleSchema}
>
  <Nav />
  <main class="page">
    <div class="container">
      <article class="post">
        <div class="post-head">
          <a class="back" href="/blog">← All articles</a>
          <div class="kicker">{post.data.category}</div>
          <h1>{post.data.title}</h1>
          <p class="meta">
            <span>{post.data.author}</span>
            <span class="dot">·</span>
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          </p>
        </div>

        <div class="prose">
          <Content />
        </div>

        <div class="post-cta">
          <h2>Grit is built for exactly this.</h2>
          <p>A modern chiropractic EHR for solo, cash-pay practices — $49/month, no contract.</p>
          <a class="cta-btn" href="/waitlist">Join the Waitlist</a>
          <p class="no-card">No credit card required</p>
        </div>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page { padding: 52px 0 84px; }
  .post { max-width: 720px; margin: 0 auto; }

  .post-head { display: grid; gap: 14px; margin-bottom: 36px; }
  .back {
    color: var(--subtle);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .back:hover { color: var(--text); }

  .kicker {
    color: var(--ember);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    margin: 0;
  }

  .meta {
    color: var(--subtle);
    font-size: 0.92rem;
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 0;
  }
  .dot { opacity: 0.5; }

  /* Prose typography lives in src/styles/prose.css (shared with /help). */

  /* CTA */
  .post-cta {
    margin-top: 56px;
    padding: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 24px;
    background: linear-gradient(160deg, rgba(86, 38, 12, 0.55), rgba(60, 28, 8, 0.7));
    text-align: center;
    display: grid;
    gap: 10px;
    justify-items: center;
  }
  .post-cta h2 { margin: 0; font-size: 1.6rem; letter-spacing: -0.03em; }
  .post-cta p { margin: 0; color: var(--muted); }
  .cta-btn {
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 30px;
    border-radius: 999px;
    background: #F4F1EC;
    color: #2A2A2A;
    font-weight: 800;
    transition: 180ms ease;
  }
  .cta-btn:hover { background: #fff; transform: translateY(-1px); }
  .no-card { font-size: 0.82rem; color: var(--subtle); }
</style>
