---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FaqList from '../components/ui/FaqList.astro';
import WaitlistCTA from '../components/ui/WaitlistCTA.astro';
import { PRICING, CTA, CONTACT_EMAIL } from '../lib/site';

const included = [
  'One provider — and unlimited staff accounts',
  'Unlimited patients and appointments',
  'SOAP notes built for chiropractic',
  'Care plans',
  'Scheduling with online self-booking',
  'Text & email appointment reminders',
  'Patient payments (cards via Stripe)',
  'Patient portal — booking, forms, messages, bills',
  'Secure messaging',
  'Data import from your old EHR',
  'HIPAA compliant, BAA included',
  'Data export anytime',
];

const examples = [
  { label: 'Solo, cash practice', math: `$${PRICING.base}/mo` },
  { label: 'Two providers', math: `$${PRICING.base + PRICING.perProvider}/mo` },
  { label: 'Two providers + insurance', math: `$${PRICING.base + PRICING.perProvider + PRICING.insuranceAddon}/mo` },
];

const faqs = [
  {
    q: 'Is there a free trial?',
    a: `No — but you can see everything before you pay. The walkthrough videos in our Help Center show the real product doing the actual work, and Grit is month-to-month, so you can cancel anytime.`,
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. No contracts, no cancellation fees. Cancel from your account settings whenever you want, and your data exports with you.',
  },
  {
    q: 'What counts as an additional provider?',
    a: `A provider is a chiropractor with their own schedule and their own notes. Staff — front desk, office managers, billers — are unlimited and included at every practice size.`,
  },
  {
    q: 'How does the insurance add-on work?',
    a: `$${PRICING.insuranceAddon}/month, optional, on or off whenever you want. Claim submission, status tracking, and payment posting all happen inside Grit. You bring your own Claim.MD clearinghouse account — that subscription and its support relationship stay between you and Claim.MD.`,
  },
  {
    q: 'Is Grit built for multi-provider clinics?',
    a: `Grit is built for independent practices — solo or growing. Each additional provider is $${PRICING.perProvider}/month. No tier jump, no "contact sales."`,
  },
  {
    q: 'Is my patient data secure?',
    a: 'Yes. Grit is HIPAA compliant: data is encrypted in transit and at rest, hosted on AWS infrastructure, with regular backups.',
  },
  {
    q: 'Do you provide a Business Associate Agreement (BAA)?',
    a: 'Yes. A BAA is included with every account — no extra steps, no extra cost.',
  },
  {
    q: 'Can I migrate data from my current EHR?',
    a: 'Yes. Grit imports patients, insurance, and appointments from the CSV or Excel exports your current system produces, with a dry-run preview before anything is written. We help you through it.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<BaseLayout
  title={`Pricing — $${PRICING.base}/mo Chiropractic EHR, No Contract | Chiropractic Grit`}
  description={`Grit is $${PRICING.base}/month for everything — one provider, unlimited staff. Each additional provider is $${PRICING.perProvider}/month; insurance billing is an optional $${PRICING.insuranceAddon}/month add-on. Month-to-month, no setup fees, no contract.`}
  schema={faqSchema}
>
  <Nav />

  <main class="page">
    <div class="container">

      <!-- Header -->
      <header class="page-header">
        <div class="rule"><span class="kicker">Pricing</span></div>
        <h1>One price. Then only what you add.</h1>
        <p class="header-copy">
          The whole practice for ${PRICING.base} a month. Add a provider when you grow,
          add insurance billing when you want it — and nothing else costs anything.
        </p>
      </header>

      <!-- The statement: pricing on paper -->
      <div class="statement paper">
        <div class="statement-main">
          <div class="price-block">
            <div class="price">
              <span class="amount">${PRICING.base}</span>
              <span class="period">/ month</span>
            </div>
            <p class="price-desc">
              Everything below. One provider, unlimited staff accounts.
              Billed monthly, cancel anytime.
            </p>
            <a class="cta-btn" href={CTA.href}>{CTA.label}</a>
            <p class="no-card">No credit card required</p>
          </div>

          <div class="includes">
            <p class="includes-label">Everything included</p>
            <ul class="feature-list">
              {included.map((f) => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="addons">
          <div class="addon-row">
            <div>
              <span class="addon-name">Each additional provider</span>
              <span class="addon-copy">Their own schedule, their own notes. Staff never count.</span>
            </div>
            <span class="addon-price">+${PRICING.perProvider}/mo</span>
          </div>
          <div class="addon-row">
            <div>
              <span class="addon-name">Insurance billing <em>optional</em></span>
              <span class="addon-copy">
                Submit claims from a signed note, track them, post payments — inside Grit.
                You bring your own Claim.MD account; their subscription and support stay with them.
              </span>
            </div>
            <span class="addon-price">+${PRICING.insuranceAddon}/mo</span>
          </div>
        </div>

        <div class="examples">
          {examples.map((ex) => (
            <div class="example">
              <span class="ex-label">{ex.label}</span>
              <span class="ex-math">{ex.math}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Trust bar -->
      <div class="trust-bar">
        <span>HIPAA Compliant</span>
        <span>BAA Included</span>
        <span>Cancel Anytime</span>
        <span>Built for Independent Practices</span>
      </div>

      <!-- The honesty block -->
      <section class="honesty">
        <div class="rule"><span class="kicker">Said plainly</span></div>
        <div class="honesty-grid">
          <article>
            <h3>No free trial</h3>
            <p>
              You can see everything before you pay — the walkthrough videos show the real
              product — and it's month-to-month, so the exit is always open. We'd rather
              earn month two than discount month one.
            </p>
          </article>
          <article>
            <h3>What's not ours</h3>
            <p>
              Stripe's card-processing fees on patient payments go to Stripe, like every
              payment product. The Claim.MD account behind the insurance add-on is yours —
              their subscription, their support line. Grit adds no markup to either.
            </p>
          </article>
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq-section">
        <div class="rule"><span class="kicker">Common questions</span></div>
        <h2>Asked and answered.</h2>
        <FaqList faqs={faqs} />
      </section>

    </div>
  </main>

  <WaitlistCTA
    kicker="Early access"
    title="The price is the whole pitch."
    copy={`Join the waitlist and we'll reach out before launch. Questions first? Write us at ${CONTACT_EMAIL}.`}
  />

  <Footer />
</BaseLayout>

<style>
  .page {
    padding: 52px 0 20px;
  }

  .rule {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 560px;
  }

  .rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  /* Header */
  .page-header {
    max-width: 680px;
    margin-bottom: 52px;
    display: grid;
    gap: 16px;
  }

  h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    line-height: 1.02;
  }

  .header-copy {
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
    margin: 0;
  }

  /* The statement */
  .statement {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-paper);
    overflow: hidden;
    margin-bottom: 18px;
  }

  .statement-main {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 40px;
    padding: clamp(28px, 4.5vw, 48px);
  }

  .price-block {
    display: flex;
    flex-direction: column;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 14px;
  }

  .amount {
    font-family: var(--font-mono);
    font-size: 4.4rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
  }

  .period {
    color: var(--ink-muted);
    font-size: 1rem;
  }

  .price-desc {
    color: var(--ink-muted);
    font-size: 0.97rem;
    line-height: 1.65;
    margin: 0 0 28px;
    flex: 1;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    border-radius: var(--radius-sm);
    background: var(--ember);
    color: #fff;
    font-weight: 700;
    font-size: 0.98rem;
    transition: 180ms ease;
    box-shadow: 0 12px 28px rgba(199, 78, 14, 0.24);
    margin-bottom: 12px;
  }

  .cta-btn:hover {
    background: var(--ember-strong);
    transform: translateY(-1px);
  }

  .no-card {
    color: var(--ink-muted);
    font-size: 0.82rem;
    text-align: center;
    margin: 0;
  }

  .includes-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ember);
    margin: 0 0 18px;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.4;
  }

  .feature-list li svg {
    color: var(--ember);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Add-on rows */
  .addons {
    border-top: 1px solid var(--line-paper);
    padding: 8px clamp(28px, 4.5vw, 48px);
  }

  .addon-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
  }

  .addon-row + .addon-row {
    border-top: 1px solid var(--line-paper);
  }

  .addon-row > div {
    display: grid;
    gap: 4px;
  }

  .addon-name {
    font-weight: 700;
    color: var(--ink);
  }

  .addon-name em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ember);
    margin-left: 8px;
  }

  .addon-copy {
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 62ch;
  }

  .addon-price {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--ember);
    white-space: nowrap;
  }

  /* Worked examples */
  .examples {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-paper);
    background: var(--bone-shade);
  }

  .example {
    padding: 18px clamp(20px, 3vw, 32px);
    display: grid;
    gap: 4px;
  }

  .example + .example {
    border-left: 1px solid var(--line-paper);
  }

  .ex-label {
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .ex-math {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
  }

  /* Trust bar */
  .trust-bar {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px 36px;
    padding: 16px 24px 0;
    margin-bottom: 84px;
  }

  .trust-bar span {
    color: var(--subtle);
    font-size: 0.88rem;
    font-weight: 500;
  }

  /* Honesty block */
  .honesty {
    display: grid;
    gap: 34px;
    margin-bottom: 84px;
  }

  .honesty-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    max-width: 980px;
  }

  .honesty-grid article {
    border-top: 1px solid var(--line-strong);
    padding-top: 18px;
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .honesty-grid h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  .honesty-grid p {
    margin: 0;
    line-height: 1.65;
    color: var(--muted);
  }

  /* FAQ */
  .faq-section {
    display: grid;
    gap: 22px;
    margin-bottom: 20px;
  }

  h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    color: var(--text);
    margin-bottom: 12px;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .statement-main {
      grid-template-columns: 1fr;
    }

    .feature-list {
      grid-template-columns: 1fr;
    }

    .examples {
      grid-template-columns: 1fr;
    }

    .example + .example {
      border-left: none;
      border-top: 1px solid var(--line-paper);
    }

    .honesty-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
