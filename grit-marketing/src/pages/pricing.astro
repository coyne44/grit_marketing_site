---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const features = [
  'Unlimited patients',
  'Unlimited appointments',
  'SOAP notes with chiro-specific templates',
  'Patient portal',
  'Secure messaging',
  'Online scheduling',
  'Automated appointment reminders',
  'Payment processing via Stripe',
  'HIPAA compliant',
  'Business Associate Agreement (BAA) included',
  'Data export anytime',
  'Email & chat support',
];

const faqs = [
  {
    q: 'Is there a free trial?',
    a: 'Yes — early access members get a full trial period before any billing starts. No credit card required to join the waitlist.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Absolutely. No contracts, no cancellation fees. Cancel from your account settings whenever you want.',
  },
  {
    q: 'Is my patient data secure?',
    a: 'Yes. Grit is fully HIPAA compliant. All data is encrypted in transit and at rest, hosted on AWS infrastructure with regular backups.',
  },
  {
    q: 'Do you provide a Business Associate Agreement (BAA)?',
    a: 'Yes. A BAA is included with every account — no extra steps, no extra cost.',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'We accept all major credit and debit cards via Stripe.',
  },
  {
    q: 'Can I migrate data from my current EHR?',
    a: "We're building data migration tools and will work with you directly on this during onboarding. Reach out and we'll figure out the best path for your setup.",
  },
  {
    q: 'Is Grit built for multi-provider clinics?',
    a: "Grit is built for solo chiropractors and small independent practices. If you're running a larger multi-provider operation, it may not be the right fit — yet.",
  },
];
---

<BaseLayout
  title="Pricing | Chiropractic Grit"
  description="Simple, transparent pricing for solo chiropractors. One plan, everything included. No per-provider fees, no surprises."
>
  <Nav />

  <main class="page">
    <div class="container">

      <!-- Header -->
      <div class="page-header">
        <div class="kicker">Pricing</div>
        <h1>One plan. Everything included.</h1>
        <p class="header-copy">
          No tiers to decipher, no per-provider fees, no hidden charges.
          Just one straightforward price for everything you need to run your practice.
        </p>
      </div>

      <!-- Pricing card -->
      <div class="pricing-wrap">
        <div class="pricing-card">
          <div class="pricing-left">
            <div class="plan-name">Grit Pro</div>
            <div class="price">
              <span class="amount">$99</span>
              <span class="period">/ month</span>
            </div>
            <p class="plan-desc">
              Everything a solo chiropractor needs to run a modern, efficient practice.
              Billed monthly, cancel anytime.
            </p>
            <a class="cta-btn" href="/waitlist">Join the Waitlist</a>
            <p class="no-card">No credit card required</p>
          </div>

          <div class="pricing-right">
            <p class="includes-label">Everything included:</p>
            <ul class="feature-list">
              {features.map((f) => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="trust-bar">
          <span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
            HIPAA Compliant
          </span>
          <span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
            BAA Included
          </span>
          <span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            Cancel Anytime
          </span>
          <span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
            Built for Solo Practices
          </span>
        </div>
      </div>

      <!-- FAQ -->
      <div class="faq-section">
        <div class="faq-header">
          <div class="kicker">FAQ</div>
          <h2>Common questions.</h2>
        </div>

        <div class="faq-grid">
          {faqs.map((faq) => (
            <div class="faq-item">
              <h3>{faq.q}</h3>
              <p>{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom CTA -->
      <div class="bottom-cta">
        <h2>Still have questions?</h2>
        <p>We're happy to walk you through anything before you commit.</p>
        <a class="ghost-btn" href="mailto:hello@gritcrm.com">Get in touch</a>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page {
    padding: 52px 0 84px;
  }

  /* Header */
  .page-header {
    max-width: 640px;
    margin-bottom: 52px;
    display: grid;
    gap: 14px;
  }

  .kicker {
    color: var(--ember);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    margin: 0;
  }

  .header-copy {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Pricing card */
  .pricing-wrap {
    margin-bottom: 72px;
  }

  .pricing-card {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 0;
    border: 1px solid var(--line-strong);
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--shadow);
    margin-bottom: 0;
  }

  .pricing-left {
    padding: 40px;
    background: linear-gradient(160deg, rgba(86, 38, 12, 0.92), rgba(60, 28, 8, 0.98));
    border-right: 1px solid rgba(255,255,255,0.06);
    display: flex;
    flex-direction: column;
  }

  .plan-name {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(244,241,236,0.55);
    margin-bottom: 20px;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 16px;
  }

  .amount {
    font-size: 4rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .period {
    color: rgba(244,241,236,0.5);
    font-size: 1rem;
  }

  .plan-desc {
    color: rgba(244,241,236,0.7);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0 0 32px;
    flex: 1;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    border-radius: 999px;
    background: #F4F1EC;
    color: #2A2A2A;
    font-weight: 800;
    font-size: 0.97rem;
    letter-spacing: -0.01em;
    transition: 180ms ease;
    text-align: center;
    margin-bottom: 12px;
  }

  .cta-btn:hover {
    background: #fff;
    transform: translateY(-1px);
  }

  .no-card {
    color: rgba(244,241,236,0.38);
    font-size: 0.82rem;
    text-align: center;
    margin: 0;
  }

  .pricing-right {
    padding: 40px;
    background: linear-gradient(180deg, rgba(255,255,255,0.028), rgba(255,255,255,0.016));
  }

  .includes-label {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--subtle);
    margin: 0 0 20px;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.4;
  }

  .feature-list li svg {
    color: var(--ember);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Trust bar */
  .trust-bar {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 24px 36px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-top: none;
    border-radius: 0 0 22px 22px;
    background: rgba(255,255,255,0.015);
  }

  .trust-bar span {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--subtle);
    font-size: 0.88rem;
    font-weight: 500;
  }

  .trust-bar span svg {
    color: var(--ember);
  }

  /* FAQ */
  .faq-section {
    margin-bottom: 72px;
  }

  .faq-header {
    display: grid;
    gap: 12px;
    margin-bottom: 36px;
  }

  h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .faq-item {
    padding: 24px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255,255,255,0.024), rgba(255,255,255,0.014));
  }

  .faq-item:first-child { border-radius: 22px 0 0 0; }
  .faq-item:nth-child(2) { border-radius: 0 22px 0 0; }
  .faq-item:nth-last-child(2) { border-radius: 0 0 0 22px; }
  .faq-item:last-child { border-radius: 0 0 22px 0; }

  .faq-item h3 {
    font-size: 1rem;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }

  .faq-item p {
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.65;
    margin: 0;
  }

  /* Bottom CTA */
  .bottom-cta {
    text-align: center;
    padding: 52px 24px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(255,255,255,0.024), rgba(255,255,255,0.014));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .bottom-cta h2 {
    margin: 0;
  }

  .bottom-cta p {
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
  }

  .ghost-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-weight: 700;
    font-size: 0.95rem;
    transition: 180ms ease;
    margin-top: 4px;
  }

  .ghost-btn:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(244,241,236,0.28);
    transform: translateY(-1px);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .pricing-card {
      grid-template-columns: 1fr;
    }

    .pricing-left {
      border-right: none;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .feature-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .faq-item:first-child { border-radius: 22px 22px 0 0; }
    .faq-item:nth-child(2) { border-radius: 0; }
    .faq-item:nth-last-child(2) { border-radius: 0; }
    .faq-item:last-child { border-radius: 0 0 22px 22px; }

    .pricing-left,
    .pricing-right {
      padding: 28px;
    }
  }
</style>
