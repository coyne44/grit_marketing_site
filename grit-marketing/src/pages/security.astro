---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const measures = [
  {
    title: 'Encryption in transit & at rest',
    description: 'All data is encrypted using TLS 1.3 in transit and AES-256 at rest. Your patient records are protected end to end.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>`,
  },
  {
    title: 'AWS infrastructure',
    description: 'Hosted on Amazon Web Services with US-based data centers. AWS maintains SOC 2 Type II and ISO 27001 compliance.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z" /></svg>`,
  },
  {
    title: 'Access controls & audit logs',
    description: 'Role-based access controls limit who can see what. Every action in the system is logged and auditable.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" /></svg>`,
  },
  {
    title: 'Regular backups',
    description: 'Your data is backed up automatically on a regular schedule. In the event of any incident, restoration is fast.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>`,
  },
  {
    title: 'Secure messaging',
    description: 'Patient-provider communication is encrypted and isolated. No PHI ever travels through unprotected channels.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" /></svg>`,
  },
  {
    title: 'You own your data',
    description: 'Export your full dataset at any time, no questions asked. We never sell, share, or monetize your patient data.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>`,
  },
];
---

<BaseLayout
  title="Security & HIPAA Compliance | Chiropractic Grit"
  description="Grit is fully HIPAA compliant. Encrypted data, AWS hosting, BAA included with every account. Your patients' information is protected."
>
  <Nav />

  <main class="page">
    <div class="container">

      <!-- Header -->
      <div class="page-header">
        <div class="kicker">Security & Compliance</div>
        <h1>HIPAA compliant.<br />Built that way from day one.</h1>
        <p class="header-copy">
          Running a chiropractic practice means handling protected health information every day.
          Grit is built with the controls, infrastructure, and agreements you need to stay compliant
          and keep your patients' data safe.
        </p>
      </div>

      <!-- HIPAA statement -->
      <div class="hipaa-banner">
        <div class="hipaa-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="28" height="28"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
        </div>
        <div>
          <h2>Grit is fully HIPAA compliant.</h2>
          <p>
            We sign a Business Associate Agreement (BAA) with every customer — included automatically,
            at no extra cost. No paperwork chase, no legal back-and-forth.
          </p>
        </div>
        <a class="baa-btn" href="/waitlist">Get Your BAA</a>
      </div>

      <!-- Security measures grid -->
      <div class="measures-section">
        <div class="section-label">How we protect your data</div>
        <div class="measures-grid">
          {measures.map((m) => (
            <div class="measure-card">
              <div class="measure-icon" set:html={m.svg} />
              <h3>{m.title}</h3>
              <p>{m.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Data ownership -->
      <div class="ownership-section">
        <div class="ownership-card">
          <div class="ownership-text">
            <div class="kicker">Data Ownership</div>
            <h2>Your data is yours. Always.</h2>
            <p>
              You can export your full dataset — patients, notes, appointments, everything — at any time.
              If you ever leave Grit, you take your data with you. We don't hold it hostage, and we
              never sell it to anyone for any reason.
            </p>
            <ul class="ownership-list">
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" width="15" height="15"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                Full data export available anytime
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" width="15" height="15"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                We never sell or share patient data
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" width="15" height="15"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                US-based data centers only
              </li>
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" width="15" height="15"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                Data deleted upon account closure on request
              </li>
            </ul>
          </div>
          <div class="ownership-visual">
            <div class="visual-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.4" stroke="currentColor" width="48" height="48"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>
            </div>
            <p class="visual-label">Your data.<br />Your terms.</p>
          </div>
        </div>
      </div>

      <!-- Bottom CTA -->
      <div class="bottom-cta">
        <h2>Questions about compliance?</h2>
        <p>We're happy to walk through our security setup before you sign up.</p>
        <div class="cta-row">
          <a class="primary-btn" href="/waitlist">Join the Waitlist</a>
          <a class="ghost-btn" href="mailto:hello@chiropracticgrit.com">Email Us</a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page {
    padding: 52px 0 84px;
  }

  /* Header */
  .page-header {
    max-width: 700px;
    margin-bottom: 52px;
    display: grid;
    gap: 14px;
  }

  .kicker {
    color: var(--ember);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin: 0;
  }

  .header-copy {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
    max-width: 62ch;
  }

  /* HIPAA Banner */
  .hipaa-banner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 32px 36px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(86, 38, 12, 0.9), rgba(60, 28, 8, 0.96));
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: var(--shadow);
    margin-bottom: 64px;
  }

  .hipaa-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: rgba(199, 78, 14, 0.22);
    color: #F4F1EC;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .hipaa-banner h2 {
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    margin: 0 0 6px;
  }

  .hipaa-banner p {
    color: rgba(244,241,236,0.72);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .baa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    background: #F4F1EC;
    color: #2A2A2A;
    font-weight: 800;
    font-size: 0.92rem;
    white-space: nowrap;
    transition: 180ms ease;
  }

  .baa-btn:hover {
    background: #fff;
    transform: translateY(-1px);
  }

  /* Measures */
  .measures-section {
    margin-bottom: 64px;
  }

  .section-label {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--subtle);
    margin-bottom: 20px;
  }

  .measures-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .measure-card {
    padding: 26px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255,255,255,0.028), rgba(255,255,255,0.016));
    box-shadow: var(--shadow);
  }

  .measure-icon {
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: var(--ember-soft);
    color: var(--ember);
    display: grid;
    place-items: center;
    margin-bottom: 16px;
  }

  h3 {
    font-size: 1.05rem;
    letter-spacing: -0.025em;
    margin: 0 0 8px;
  }

  .measure-card p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
  }

  /* Ownership */
  .ownership-section {
    margin-bottom: 64px;
  }

  .ownership-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
    padding: 44px;
    border-radius: 28px;
    border: 1px solid var(--line-strong);
    background: linear-gradient(180deg, rgba(255,255,255,0.032), rgba(255,255,255,0.018));
    box-shadow: var(--shadow);
  }

  .ownership-text .kicker {
    margin-bottom: 12px;
    display: block;
  }

  h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    margin: 0 0 14px;
  }

  .ownership-text p {
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.98rem;
    margin: 0 0 22px;
    max-width: 58ch;
  }

  .ownership-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }

  .ownership-list li {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .ownership-list li svg {
    color: var(--ember);
    flex-shrink: 0;
  }

  .ownership-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .visual-icon {
    width: 96px;
    height: 96px;
    border-radius: 999px;
    background: var(--ember-soft);
    color: var(--ember);
    display: grid;
    place-items: center;
  }

  .visual-label {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Bottom CTA */
  .bottom-cta {
    text-align: center;
    padding: 52px 24px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(255,255,255,0.024), rgba(255,255,255,0.014));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .bottom-cta h2 {
    margin: 0;
  }

  .bottom-cta p {
    color: var(--muted);
    font-size: 1rem;
    margin: 0;
  }

  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 4px;
  }

  .primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 999px;
    background: var(--ember);
    color: var(--text);
    font-weight: 800;
    font-size: 0.95rem;
    transition: 180ms ease;
    box-shadow: 0 10px 24px rgba(199,78,14,0.22);
  }

  .primary-btn:hover {
    background: var(--ember-strong);
    transform: translateY(-1px);
  }

  .ghost-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-weight: 700;
    font-size: 0.95rem;
    transition: 180ms ease;
  }

  .ghost-btn:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(244,241,236,0.28);
    transform: translateY(-1px);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hipaa-banner {
      grid-template-columns: auto 1fr;
    }

    .baa-btn {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .measures-grid {
      grid-template-columns: 1fr 1fr;
    }

    .ownership-card {
      grid-template-columns: 1fr;
    }

    .ownership-visual {
      flex-direction: row;
      text-align: left;
    }
  }

  @media (max-width: 600px) {
    .hipaa-banner {
      grid-template-columns: 1fr;
      padding: 24px;
    }

    .measures-grid {
      grid-template-columns: 1fr;
    }

    .ownership-card {
      padding: 28px;
    }
  }
</style>
