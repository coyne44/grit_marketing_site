---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import WaitlistCTA from '../components/ui/WaitlistCTA.astro';
import { CONTACT_EMAIL } from '../lib/site';

const measures = [
  {
    title: 'Encryption in transit & at rest',
    description: 'TLS 1.3 in transit, AES-256 at rest. Patient records are protected end to end.',
  },
  {
    title: 'AWS infrastructure',
    description: 'US-based data centers on Amazon Web Services, which maintains SOC 2 Type II and ISO 27001 compliance.',
  },
  {
    title: 'An audit log that cannot be rewritten',
    description: 'Every access to patient data is written to a clinical audit log that is append-only down to the database itself — entries cannot be edited or deleted, by anyone.',
  },
  {
    title: 'Role-based access',
    description: 'Providers, staff, and patients each see exactly what their role allows. Nothing more.',
  },
  {
    title: 'Two-factor sign-in',
    description: 'Email one-time codes on login keep a stolen password from becoming a breach.',
  },
  {
    title: 'Regular backups',
    description: 'Automatic backups on a regular schedule, so restoration after any incident is fast.',
  },
];
---

<BaseLayout
  title="Security & HIPAA Compliance | Chiropractic Grit"
  description="Grit is HIPAA compliant: encrypted data, AWS hosting, an append-only clinical audit log, two-factor sign-in, and a BAA included with every account."
>
  <Nav />

  <main class="page">
    <div class="container">

      <header class="page-header">
        <div class="rule"><span class="kicker">Security &amp; Compliance</span></div>
        <h1>Their data, treated like it's yours.</h1>
        <p class="header-copy">
          A chiropractic practice handles protected health information all day, every day.
          Grit was built with the controls, the infrastructure, and the agreements that
          responsibility requires — from the first line of code, not as a retrofit.
        </p>
      </header>

      <!-- BAA panel: honest interim until the published /baa document exists -->
      <!-- TODO: link the BAA PDF / /baa page when the legal doc lands (separate workstream) -->
      <section class="baa paper">
        <div class="baa-text">
          <span class="kicker baa-kicker">The agreement</span>
          <h2>A BAA with every practice.</h2>
          <p>
            HIPAA requires a Business Associate Agreement between your practice and any
            software that touches PHI. Grit includes one with every account — signed during
            onboarding, automatically, at no extra cost. No paperwork chase, no legal
            back-and-forth.
          </p>
          <p class="baa-fine">
            Want to read it before you sign up, or have compliance questions?
            Write us at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> — a real
            person answers.
          </p>
        </div>
      </section>

      <!-- Measures -->
      <section class="measures">
        <SectionHeader kicker="How we protect it" title="The controls, specifically." />
        <div class="measures-grid">
          {measures.map((m) => (
            <article>
              <h3>{m.title}</h3>
              <p>{m.description}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Data ownership -->
      <section class="ownership">
        <SectionHeader
          kicker="Data ownership"
          title="Your data is yours. Always."
          copy="If you ever leave Grit, you take everything with you. We don't hold data hostage, and we never sell it — to anyone, for any reason."
        />
        <ul class="ownership-list">
          <li>Full data export — patients, notes, appointments, everything — available anytime</li>
          <li>Patient data is never sold, shared, or monetized</li>
          <li>US-based data centers only</li>
          <li>Data deleted on request when an account closes</li>
        </ul>
      </section>

    </div>
  </main>

  <WaitlistCTA
    kicker="Early access"
    title="Compliance shouldn't be the hard part."
    copy={`Join the waitlist and we'll reach out before launch. Compliance questions first? ${CONTACT_EMAIL}.`}
  />

  <Footer />
</BaseLayout>

<style>
  .page {
    padding: 52px 0 20px;
  }

  .rule {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 560px;
  }

  .rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  .page-header {
    max-width: 720px;
    margin-bottom: 56px;
    display: grid;
    gap: 16px;
  }

  h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    line-height: 1.04;
  }

  .header-copy {
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
    margin: 0;
  }

  /* BAA panel */
  .baa {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-paper);
    padding: clamp(32px, 5vw, 52px);
    margin-bottom: 84px;
  }

  .baa-text {
    display: grid;
    gap: 14px;
    max-width: 720px;
  }

  .baa-kicker {
    color: var(--ember);
  }

  .baa h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    color: var(--ink);
  }

  .baa p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .baa-fine {
    border-top: 1px solid var(--line-paper);
    padding-top: 16px;
    font-size: 0.92rem;
  }

  .baa a {
    color: var(--ember);
    font-weight: 600;
  }

  /* Measures */
  .measures {
    display: grid;
    gap: 38px;
    margin-bottom: 84px;
  }

  .measures-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px 32px;
  }

  .measures-grid article {
    border-top: 1px solid var(--line-strong);
    padding-top: 16px;
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .measures-grid h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
  }

  .measures-grid p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Ownership */
  .ownership {
    display: grid;
    gap: 30px;
    margin-bottom: 20px;
  }

  .ownership-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 40px;
    max-width: 900px;
  }

  .ownership-list li {
    color: var(--muted);
    line-height: 1.55;
    padding-left: 18px;
    position: relative;
  }

  .ownership-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--ember-strong);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .measures-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .ownership-list {
      grid-template-columns: 1fr;
    }
  }
</style>
