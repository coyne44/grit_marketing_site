---
---

<section class="cta-section" id="waitlist">
  <div class="container">
    <div class="cta-card">
      <div class="kicker">Get Early Access</div>
      <h2>Start your practice with confidence.</h2>
      <p>
        Join the waitlist to be one of the first chiropractors to use Grit—a modern EHR built for certainty,
        simplicity, and affordability.
      </p>

      <form
        class="waitlist-form"
        action="https://formspree.io/f/mykbzwjp"
        method="POST"
        id="waitlist-form"
      >
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          class="email-input"
          aria-label="Email address"
        />
        <button type="submit" class="btn">Join the Waitlist</button>
      </form>

      <p class="form-note" id="form-success" style="display:none">
        You're on the list. We'll be in touch.
      </p>

      <p class="fine-print">No credit card required. We'll never spam you.</p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const res = await fetch(form.action, {
      method: 'POST',
      body: data,
      headers: { Accept: 'application/json' },
    });
    if (res.ok) {
      form.style.display = 'none';
      if (success) success.style.display = 'block';
    }
  });
</script>

<style>
  .cta-section {
    padding: 38px 0 84px;
  }

  .cta-card {
    padding: 52px 48px;
    border-radius: 28px;
    background:
      radial-gradient(circle at 85% 20%, rgba(229, 106, 32, 0.10), transparent 22%),
      linear-gradient(135deg, rgba(86, 38, 12, 0.96), rgba(122, 48, 12, 0.96));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .kicker {
    color: rgba(244, 241, 236, 0.6);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  h2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin-bottom: 14px;
  }

  p {
    color: #f7ebe2;
    margin: 0 0 28px;
    max-width: 52ch;
    line-height: 1.65;
    font-size: 1.05rem;
  }

  .waitlist-form {
    display: flex;
    gap: 10px;
    width: 100%;
    max-width: 460px;
    margin-bottom: 14px;
  }

  .email-input {
    flex: 1;
    min-height: 52px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid rgba(244, 241, 236, 0.18);
    background: rgba(0, 0, 0, 0.22);
    color: #F4F1EC;
    font-size: 0.97rem;
    outline: none;
    font-family: inherit;
    transition: 180ms ease;
  }

  .email-input::placeholder {
    color: rgba(244, 241, 236, 0.38);
  }

  .email-input:focus {
    border-color: rgba(244, 241, 236, 0.36);
    background: rgba(0, 0, 0, 0.30);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    border: none;
    background: #F4F1EC;
    color: #2A2A2A;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: 180ms ease;
    cursor: pointer;
    font-family: inherit;
  }

  .btn:hover {
    background: #ffffff;
    transform: translateY(-1px);
  }

  .form-note {
    color: rgba(244, 241, 236, 0.85) !important;
    font-size: 1rem !important;
    margin: 0 0 14px !important;
  }

  .fine-print {
    color: rgba(244, 241, 236, 0.38) !important;
    font-size: 0.84rem !important;
    margin: 0 !important;
  }

  @media (max-width: 760px) {
    .cta-card {
      padding: 36px 22px;
    }

    .waitlist-form {
      flex-direction: column;
    }

    .email-input,
    .btn {
      width: 100%;
    }
  }
</style>
