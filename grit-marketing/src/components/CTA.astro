---

<section class="cta-section" id="waitlist">
  <div class="container">
    <div class="cta-card">
      <div class="kicker">Get Early Access</div>
      <h2>Start your practice with confidence.</h2>
      <p>
        Join the waitlist to be one of the first chiropractors to use Grit—a modern EHR built for certainty,
        simplicity, and affordability.
      </p>
      <a class="btn" href="/waitlist">Join the Waitlist</a>
      <p class="fine-print">No credit card required. We'll never spam you.</p>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 38px 0 84px;
  }

  .cta-card {
    padding: 52px 48px;
    border-radius: 28px;
    background:
      radial-gradient(circle at 85% 20%, rgba(229, 106, 32, 0.10), transparent 22%),
      linear-gradient(135deg, rgba(86, 38, 12, 0.96), rgba(122, 48, 12, 0.96));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .kicker {
    color: rgba(244, 241, 236, 0.6);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  h2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin-bottom: 14px;
  }

  p {
    color: #f7ebe2;
    margin: 0 0 28px;
    max-width: 52ch;
    line-height: 1.65;
    font-size: 1.05rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 32px;
    border-radius: 999px;
    background: #F4F1EC;
    color: #2A2A2A;
    font-weight: 800;
    font-size: 0.97rem;
    letter-spacing: -0.01em;
    transition: 180ms ease;
    margin-bottom: 16px;
  }

  .btn:hover {
    background: #ffffff;
    transform: translateY(-1px);
  }

  .fine-print {
    color: rgba(244, 241, 236, 0.38);
    font-size: 0.84rem;
    margin: 0;
  }

  @media (max-width: 760px) {
    .cta-card {
      padding: 36px 22px;
    }
  }
</style>
