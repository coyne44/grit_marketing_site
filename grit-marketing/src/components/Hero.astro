---
---

<section class="hero">
  <div class="container hero-grid">
    <div>
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        Built for chiropractors who bet on themselves
      </div>

      <h1>
        A <span class="accent">modern EHR</span> built for the solo chiropractor
      </h1>

      <p class="subheadline">
        Grit brings certainty, simplicity, and affordability to running your practice. Built specifically
        for independent practices, it gives you the tools you actually need—without the cost or complexity
        of traditional systems.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#waitlist">Join the Waitlist</a>
        <a class="btn btn-secondary" href="#features">See What Grit Includes</a>
      </div>

      <div class="hero-note">
        <span>Fast notes</span>
        <span>Simple scheduling</span>
        <span>Patient communication</span>
      </div>
    </div>

    <div class="hero-card">
      <div class="window-top">
        <div class="dots">
          <span></span><span></span><span></span>
        </div>
        <div class="window-title">Grit · Practice Dashboard</div>
      </div>

      <div class="dashboard">
        <div class="dash-hero">
          <h3>Everything you need. Nothing you don't.</h3>
          <p>
            Notes, scheduling, reminders, and patient communication—built specifically for chiropractors,
            not generic healthcare workflows.
          </p>
          <div class="chip-row">
            <div class="chip">SOAP Notes</div>
            <div class="chip">Patient Scheduling</div>
            <div class="chip">Secure Messaging</div>
          </div>
        </div>

        <div class="stat-row">
          <div class="stat">
            <span class="label">Charting</span>
            <strong>Fast SOAP flow</strong>
          </div>
          <div class="stat">
            <span class="label">Operations</span>
            <strong>Simple scheduling</strong>
          </div>
          <div class="stat">
            <span class="label">Communication</span>
            <strong>Texts + portal</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 54px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 44px;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.03);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 22px;
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--ember);
    box-shadow: 0 0 0 7px var(--ember-soft);
    flex-shrink: 0;
  }

  h1 {
    font-size: clamp(2.8rem, 5.5vw, 4.85rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 11.5ch;
  }

  .accent {
    color: #ffffff;
    position: relative;
    white-space: nowrap;
  }

  .accent::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.08em;
    height: 0.24em;
    background: var(--ember-soft);
    z-index: -1;
    border-radius: 999px;
  }

  .subheadline {
    margin: 22px 0 0;
    max-width: 62ch;
    color: var(--muted);
    font-size: 1.13rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid transparent;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: 180ms ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--ember);
    color: var(--text);
    box-shadow: 0 14px 30px rgba(199, 78, 14, 0.22);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    background: var(--ember-strong);
    box-shadow: 0 18px 32px rgba(199, 78, 14, 0.28);
  }

  .btn-secondary {
    border-color: var(--line-strong);
    color: var(--text);
    background: rgba(255, 255, 255, 0.02);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(244, 241, 236, 0.22);
  }

  .hero-note {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 20px;
    color: var(--subtle);
    font-size: 0.94rem;
  }

  /* Dashboard card */
  .hero-card {
    background: linear-gradient(180deg, rgba(55, 55, 55, 0.96), rgba(44, 44, 44, 0.98));
    border: 1px solid var(--line);
    border-radius: 28px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .window-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgba(244, 241, 236, 0.16);
  }

  .window-title {
    color: var(--subtle);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .dashboard {
    padding: 22px;
    display: grid;
    gap: 18px;
  }

  .dash-hero {
    background: linear-gradient(135deg, rgba(66, 66, 66, 0.98), rgba(52, 52, 52, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 22px;
    padding: 24px;
    display: grid;
    gap: 16px;
  }

  .dash-hero h3 {
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  .dash-hero p {
    margin: 0;
    color: #f8efe7;
    line-height: 1.55;
    font-size: 0.98rem;
  }

  .chip-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(244, 241, 236, 0.10);
    border-radius: 16px;
    padding: 14px 16px;
    color: var(--text);
    font-size: 0.93rem;
    font-weight: 600;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .stat {
    padding: 18px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.025);
  }

  .stat .label {
    color: var(--subtle);
    font-size: 0.85rem;
    margin-bottom: 8px;
    display: block;
  }

  .stat strong {
    font-size: 1.1rem;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  @media (max-width: 1040px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 34px;
    }

    h1 {
      max-width: 100%;
    }

    .chip-row,
    .stat-row {
      grid-template-columns: 1fr;
    }

    .dashboard {
      padding: 16px;
    }

    .dash-hero {
      padding: 22px;
    }
  }
</style>
