---
/** Accessible FAQ list (native details/summary — no JS). Pages that render
    this should also pass the same array to BaseLayout's `schema` prop as
    FAQPage JSON-LD so the visible text and the structured data never drift. */
interface Props {
  faqs: { q: string; a: string }[];
}

const { faqs } = Astro.props;
---

<div class="faq-list">
  {faqs.map((f) => (
    <details class="faq">
      <summary>
        <span class="q">{f.q}</span>
        <span class="marker" aria-hidden="true">+</span>
      </summary>
      <p class="a">{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-list {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  .faq {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding: 20px 2px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .q {
    font-size: 1.04rem;
    font-weight: 600;
    color: var(--text);
  }

  .marker {
    font-family: var(--font-mono);
    color: var(--ember-strong);
    font-weight: 600;
    transition: transform var(--dur) var(--ease);
  }

  details[open] .marker {
    transform: rotate(45deg);
  }

  .a {
    margin: 0;
    padding: 0 2px 22px;
    max-width: 680px;
    line-height: 1.65;
    color: var(--muted);
  }
</style>
