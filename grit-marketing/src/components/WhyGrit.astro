---
const differentiators = [
  {
    title: 'Built for chiropractors',
    description: 'Grit is designed around chiropractic workflows—not generic healthcare templates stretched to fit.',
  },
  {
    title: 'Focused by design',
    description: 'It removes unnecessary complexity so the software supports the practice instead of slowing it down.',
  },
  {
    title: 'Affordable for independents',
    description: "Solo chiropractors shouldn't have to pay enterprise prices just to run an efficient, modern practice.",
  },
];
---

<section class="section" id="difference">
  <div class="container">
    <div class="section-header">
      <div class="kicker">Why Grit is Different</div>
      <h2>Built differently—on purpose.</h2>
      <p class="section-copy">
        Grit wasn't built to imitate traditional EHRs. It was built for a different kind of practice: lean,
        independent, and intentional. That changes everything.
      </p>
    </div>

    <div class="difference-grid">
      {differentiators.map((d) => (
        <div class="difference-card">
          <h3>{d.title}</h3>
          <p>{d.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 36px 0;
  }

  .section-header {
    display: grid;
    gap: 14px;
    max-width: 780px;
    margin-bottom: 28px;
  }

  .kicker {
    color: var(--ember);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .section-copy {
    margin: 0;
    color: var(--muted);
    line-height: 1.72;
    font-size: 1.05rem;
  }

  .difference-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .difference-card {
    padding: 24px;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(54, 54, 54, 0.92), rgba(45, 45, 45, 0.92));
    box-shadow: var(--shadow);
  }

  h3 {
    margin: 0 0 10px;
    font-size: 1.1rem;
    letter-spacing: -0.03em;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 1040px) {
    .difference-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .difference-card {
      padding: 22px;
    }
  }
</style>
