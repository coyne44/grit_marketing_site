<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand">
      <div class="brand-mark">G</div>
      <div class="brand-text">
        <small>CHIROPRACTIC</small>
        <span>GRIT</span>
      </div>
    </a>

    <div class="nav-links">
      <a href="#problem">The Problem</a>
      <a href="#features">What Grit Includes</a>
      <a href="#difference">Why Grit</a>
      <a class="btn btn-primary" href="#waitlist">Join the Waitlist</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px);
    background: rgba(42, 42, 42, 0.78);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--ember) 0%, var(--ember-strong) 100%);
    display: grid;
    place-items: center;
    color: #111;
    box-shadow: 0 10px 25px rgba(199, 78, 14, 0.28);
    font-size: 0.95rem;
    font-weight: 900;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-text small {
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    color: var(--subtle);
    margin-bottom: 4px;
    font-weight: 700;
  }

  .brand-text span {
    font-size: 1.1rem;
    color: var(--text);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    border: 1px solid transparent;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: 180ms ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--ember);
    color: var(--text);
    box-shadow: 0 8px 20px rgba(199, 78, 14, 0.22);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    background: var(--ember-strong);
    box-shadow: 0 12px 24px rgba(199, 78, 14, 0.28);
  }

  @media (max-width: 760px) {
    .nav-links {
      display: none;
    }
  }
</style>
