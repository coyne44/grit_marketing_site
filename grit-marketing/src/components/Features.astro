---
const features = [
  {
    title: 'Simple, fast note taking',
    description: 'SOAP notes designed specifically for chiropractors, so documentation feels clean, focused, and fast.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>`,
  },
  {
    title: 'Easy scheduling',
    description: 'Book, manage, and track appointments without complicated workflows or the overhead of large-clinic software.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>`,
  },
  {
    title: 'Patient communication',
    description: 'Keep patients engaged with secure messaging and text reminders built into one streamlined system.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" /></svg>`,
  },
  {
    title: 'Patient portal',
    description: 'Give patients access to forms, appointments, and communication in one modern, easy-to-use experience.',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="22" height="22"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>`,
  },
];
---

<section class="section" id="features">
  <div class="container">
    <div class="section-header">
      <div class="kicker">What Grit Includes</div>
      <h2>Everything you need. Nothing you don't.</h2>
      <p class="section-copy">
        Grit is focused by design. Instead of throwing in every possible feature, it centers on the core tools
        solo chiropractors actually need to run a practice well.
      </p>
    </div>

    <div class="feature-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon" set:html={f.svg} />
          <h3>{f.title}</h3>
          <p>{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 36px 0;
  }

  .section-header {
    display: grid;
    gap: 14px;
    max-width: 780px;
    margin-bottom: 28px;
  }

  .kicker {
    color: var(--ember);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .section-copy {
    margin: 0;
    color: var(--muted);
    line-height: 1.72;
    font-size: 1.05rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .feature-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.018));
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 24px;
    box-shadow: var(--shadow);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--ember-soft);
    color: var(--ember);
    margin-bottom: 18px;
  }

  h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      padding: 22px;
    }
  }
</style>
