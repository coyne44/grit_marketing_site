---
const features = [
  {
    icon: '📝',
    title: 'Simple, fast note taking',
    description: 'SOAP notes designed specifically for chiropractors, so documentation feels clean, focused, and fast.',
  },
  {
    icon: '📅',
    title: 'Easy scheduling',
    description: 'Book, manage, and track appointments without complicated workflows or the overhead of large-clinic software.',
  },
  {
    icon: '💬',
    title: 'Patient communication',
    description: 'Keep patients engaged with secure messaging and text reminders built into one streamlined system.',
  },
  {
    icon: '🌐',
    title: 'Patient portal',
    description: 'Give patients access to forms, appointments, and communication in one modern, easy-to-use experience.',
  },
];
---

<section class="section" id="features">
  <div class="container">
    <div class="section-header">
      <div class="kicker">What Grit Includes</div>
      <h2>Everything you need. Nothing you don't.</h2>
      <p class="section-copy">
        Grit is focused by design. Instead of throwing in every possible feature, it centers on the core tools
        solo chiropractors actually need to run a practice well.
      </p>
    </div>

    <div class="feature-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 36px 0;
  }

  .section-header {
    display: grid;
    gap: 14px;
    max-width: 780px;
    margin-bottom: 28px;
  }

  .kicker {
    color: var(--ember);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .section-copy {
    margin: 0;
    color: var(--muted);
    line-height: 1.72;
    font-size: 1.05rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .feature-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.018));
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 24px;
    box-shadow: var(--shadow);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--ember-soft);
    font-size: 1.4rem;
    margin-bottom: 18px;
  }

  h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      padding: 22px;
    }
  }
</style>
