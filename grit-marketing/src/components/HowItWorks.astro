---
const steps = [
  {
    number: '01',
    title: 'Sign up in minutes',
    description: 'Create your account, set your schedule, and configure your practice details. No lengthy onboarding calls required.',
  },
  {
    number: '02',
    title: 'Add your patients',
    description: 'Import existing patients or add them as they come in. Health history forms go straight to the portal.',
  },
  {
    number: '03',
    title: 'Run your practice',
    description: 'Book appointments, write SOAP notes, message patients, and collect payments—all from one place.',
  },
];
---

<section class="section" id="how-it-works">
  <div class="container">
    <div class="section-header">
      <div class="kicker">How It Works</div>
      <h2>Up and running in a day.</h2>
      <p class="section-copy">
        Grit is built to get out of your way. Setup is straightforward so you can focus on patients,
        not software configuration.
      </p>
    </div>

    <div class="steps">
      {steps.map((step, i) => (
        <div class="step">
          <div class="step-number">{step.number}</div>
          <div class="step-body">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
          {i < steps.length - 1 && <div class="step-connector" />}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 36px 0;
  }

  .section-header {
    display: grid;
    gap: 14px;
    max-width: 780px;
    margin-bottom: 48px;
  }

  .kicker {
    color: var(--ember);
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .section-copy {
    margin: 0;
    color: var(--muted);
    line-height: 1.72;
    font-size: 1.05rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    position: relative;
  }

  .step {
    position: relative;
    padding: 0 32px 0 0;
  }

  .step:last-child {
    padding-right: 0;
  }

  .step-number {
    font-size: 3.5rem;
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(199, 78, 14, 0.4);
    margin-bottom: 20px;
  }

  .step-body {
    border-top: 1px solid var(--line-strong);
    padding-top: 20px;
  }

  .step-connector {
    position: absolute;
    top: 21px;
    right: 0;
    width: 32px;
    height: 1px;
    background: linear-gradient(90deg, var(--line-strong), transparent);
  }

  h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
    font-size: 0.98rem;
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .step {
      padding-right: 0;
    }

    .step-connector {
      display: none;
    }
  }
</style>
