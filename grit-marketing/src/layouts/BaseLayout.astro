---
import '../styles/global.css';
import { PRICING, CONTACT_EMAIL, TAGLINE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Optional extra JSON-LD objects to inject (e.g. FAQPage, Article, BreadcrumbList). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `Grit — Chiropractic EHR · ${TAGLINE}`,
  description = `Grit is a modern, chiropractic-specific EHR for independent chiropractors: scheduling, SOAP notes, care plans, patient payments, text reminders, secure messaging, and optional insurance billing. $${PRICING.base}/month — one provider, unlimited staff accounts.`,
  ogImage = '/og-image.png',
  schema,
} = Astro.props;

const SITE = Astro.site ?? new URL('https://chiropracticgrit.com');
const canonicalURL = new URL(Astro.url.pathname, SITE);
const fullTitle = title.includes('Grit') ? title : `${title} | Chiropractic Grit`;
const ogImageURL = new URL(ogImage, SITE);

// Site-wide structured data: helps Google recognize the brand entity (directly
// aids "chiropractic grit" brand search) and surface the product as software.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Chiropractic Grit',
  alternateName: 'Grit',
  url: SITE.href,
  logo: new URL('/favicon.svg', SITE).href,
  description:
    'Modern, chiropractic-specific EHR and practice-management software built for independent chiropractors.',
  email: CONTACT_EMAIL,
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Grit',
  applicationCategory: 'HealthApplication',
  applicationSubCategory: 'Chiropractic EHR & Practice Management',
  operatingSystem: 'Web',
  url: SITE.href,
  description:
    `Chiropractic EHR for independent practices: SOAP notes, scheduling, care plans, patient portal, secure messaging, text reminders, and patient payments. Optional insurance billing add-on. HIPAA compliant with BAA included.`,
  offers: {
    '@type': 'Offer',
    name: 'Grit Base',
    description: `$${PRICING.base}/month — one provider, unlimited staff accounts, everything included. Additional providers $${PRICING.perProvider}/month each; optional insurance billing add-on $${PRICING.insuranceAddon}/month.`,
    price: PRICING.base.toFixed(2),
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: PRICING.base.toFixed(2),
      priceCurrency: 'USD',
      unitText: 'MONTH',
    },
  },
};

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [organizationSchema, softwareSchema, ...extraSchemas];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Chiropractic Grit" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
